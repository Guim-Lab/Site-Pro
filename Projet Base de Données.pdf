/Title (WITH MinHfcParRegion AS \(   SELECT reg.nom_region, MONTH\(r.date_releve\) AS mois_releve, r.valeur_ppm,   RANK\(\) OVER\(PARTITION BY reg.nom_region ORDER BY r.valeur_ppm ASC\) as rang   FROM RELEVE r   JOIN CAPTEUR c ON r.id_capteur = c.id_capteur   JOIN TECHNICIEN t ON c.id_agent = t.id_agent   JOIN AGENT a ON t.id_agent = a.id_agent   JOIN AGENCE ag ON a.id_agence = ag.id_agence   JOIN REGION reg ON ag.id_region = reg.id_region   JOIN GAZ g ON c.id_gaz = g.id_gaz   WHERE g.sigle_gaz = 'HFC'  \)  SELECT nom_region, mois_releve, valeur_ppm  FROM MinHfcParRegion  WHERE rang = 1;)
