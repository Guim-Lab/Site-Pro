1182 0 obj
<<
/Type /StructElem
/S /H2
/P 400 0 R
/T (SELECT a.nom_agent, a.prenom_agent,         \(COUNT\(r.id_rapport\) / GREATEST\(TIMESTAMPDIFF\(MONTH, a.date_embauche, CURDATE\(\)\), 1\)\) AS taux_rapports_par_mois  FROM AGENT a  JOIN ADMINISTRATIF admin ON a.id_agent = admin.id_agent  JOIN AGENCE ag ON a.id_agence = ag.id_agence  LEFT JOIN Redige red ON admin.id_agent = red.id_agent  LEFT JOIN RAPPORT r ON red.id_rapport = r.id_rapport  WHERE ag.ville_agence = 'Toulouse'  GROUP BY a.id_agent, a.nom_agent, a.prenom_agent, a.date_embauche; )
/E (SELECT a.nom_agent, a.prenom_agent,         \(COUNT\(r.id_rapport\) / GREATEST\(TIMESTAMPDIFF\(MONTH, a.date_embauche, CURDATE\(\)\), 1\)\) AS taux_rapports_par_mois  FROM AGENT a  JOIN ADMINISTRATIF admin ON a.id_agent = admin.id_agent  JOIN AGENCE ag ON a.id_agence = ag.id_agence  LEFT JOIN Redige red ON admin.id_agent = red.id_agent  LEFT JOIN RAPPORT r ON red.id_rapport = r.id_rapport  WHERE ag.ville_agence = 'Toulouse'  GROUP BY a.id_agent, a.nom_agent, a.prenom_agent, a.date_embauche; )
/Pg 29 0 R
/K [1]
>>
endobj
