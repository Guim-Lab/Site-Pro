<<
/Type /StructElem
/S /H2
/P 402 0 R
/T (PREPARE stmt FROM '  SELECT DISTINCT rp.titre_rapport  FROM RAPPORT rp  JOIN Est_analyse_dans ead ON rp.id_rapport = ead.id_rapport  JOIN RELEVE r ON ead.id_releve = r.id_releve  JOIN CAPTEUR c ON r.id_capteur = c.id_capteur  JOIN GAZ g ON c.id_gaz = g.id_gaz  WHERE g.sigle_gaz = ?';   )
/E (PREPARE stmt FROM '  SELECT DISTINCT rp.titre_rapport  FROM RAPPORT rp  JOIN Est_analyse_dans ead ON rp.id_rapport = ead.id_rapport  JOIN RELEVE r ON ead.id_releve = r.id_releve  JOIN CAPTEUR c ON r.id_capteur = c.id_capteur  JOIN GAZ g ON c.id_gaz = g.id_gaz  WHERE g.sigle_gaz = ?';   )
/Pg 31 0 R
/K [1]
>>
endobj
