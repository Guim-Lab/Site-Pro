1126 0 obj
<<
/Type /StructElem
/S /H2
/P 398 0 R
/T (SELECT g.sigle_gaz, AVG\(r.valeur_ppm\) AS moyenne_ppm  FROM RELEVE r  JOIN CAPTEUR c ON r.id_capteur = c.id_capteur  JOIN TECHNICIEN t ON c.id_agent = t.id_agent  JOIN AGENT a ON t.id_agent = a.id_agent  JOIN AGENCE ag ON a.id_agence = ag.id_agence  JOIN REGION reg ON ag.id_region = reg.id_region  JOIN GAZ g ON c.id_gaz = g.id_gaz  WHERE reg.nom_region = 'Ile-de-France'   AND YEAR\(r.date_releve\) = 2020  GROUP BY g.sigle_gaz; )
/E (SELECT g.sigle_gaz, AVG\(r.valeur_ppm\) AS moyenne_ppm  FROM RELEVE r  JOIN CAPTEUR c ON r.id_capteur = c.id_capteur  JOIN TECHNICIEN t ON c.id_agent = t.id_agent  JOIN AGENT a ON t.id_agent = a.id_agent  JOIN AGENCE ag ON a.id_agence = ag.id_agence  JOIN REGION reg ON ag.id_region = reg.id_region  JOIN GAZ g ON c.id_gaz = g.id_gaz  WHERE reg.nom_region = 'Ile-de-France'   AND YEAR\(r.date_releve\) = 2020  GROUP BY g.sigle_gaz; )
/Pg 27 0 R
/K [1]
>>
endobj
