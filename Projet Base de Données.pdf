/Title (WITH StatsParRegion AS \(     SELECT reg.nom_region,            COUNT\(DISTINCT a.id_agent\) AS nb_agents,            COUNT\(DISTINCT c.id_capteur\) AS nb_capteurs     FROM AGENCE ag     JOIN REGION reg ON ag.id_region = reg.id_region     LEFT JOIN AGENT a ON ag.id_agence = a.id_agence     LEFT JOIN CAPTEUR c ON a.id_agent = c.id_agent     GROUP BY reg.nom_region  \)  SELECT nom_region   FROM StatsParRegion   WHERE nb_capteurs > nb_agents;)
/Dest [33 0 R /Fit]
/Parent 5413 0 R
>>
endobj
