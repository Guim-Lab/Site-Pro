/Title (SELECT a.nom_agent, a.prenom_agent,         \(COUNT\(r.id_rapport\) / GREATEST\(TIMESTAMPDIFF\(MONTH, a.date_embauche, CURDATE\(\)\), 1\)\) AS taux_rapports_par_mois  FROM AGENT a  JOIN ADMINISTRATIF admin ON a.id_agent = admin.id_agent  JOIN AGENCE ag ON a.id_agence = ag.id_agence  LEFT JOIN Redige red ON admin.id_agent = red.id_agent  LEFT JOIN RAPPORT r ON red.id_rapport = r.id_rapport  WHERE ag.ville_agence = 'Toulouse'  GROUP BY a.id_agent, a.nom_agent, a.prenom_agent, a.date_embauche;)
